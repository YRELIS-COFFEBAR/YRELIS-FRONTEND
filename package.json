{
  "name": "yrelis-coffeebar-frontend",
  "version": "1.0.0",
  "description": "Sistema de pedidos para tablet - Yrelis CoffeeBar (Angular 20 standalone)",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "start:lan": "ng serve --host 0.0.0.0 --port 4200 --open",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/animations": "20.3.27",
    "@angular/common": "20.3.27",
    "@angular/compiler": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/forms": "20.3.27",
    "@angular/platform-browser": "20.3.27",
    "@angular/router": "20.3.27",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.32",
    "@angular/cli": "20.3.32",
    "@angular/compiler-cli": "20.3.27",
    "typescript": "~5.8.0"
  }
}
